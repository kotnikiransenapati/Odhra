# =====================================================================
# Odhra — Environment Variables (example)
# Copy to `.env.local` for development, `.env.production` for builds.
# Every VITE_* is exposed to the browser bundle. Never put secret keys
# (service role, payment server secrets, API gateway tokens) here.
# Server-side secrets live in the backend secret store.
# =====================================================================

# --- Core backend (REQUIRED) ----------------------------------------
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="ey..."       # anon / publishable key only
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# --- Site identity --------------------------------------------------
VITE_SITE_URL="https://your-domain.com"      # canonical public URL
VITE_SITE_NAME="Odhra"
VITE_SUPPORT_EMAIL="support@your-domain.com"

# --- Payments -------------------------------------------------------
# Provider: razorpay | stripe | paypal | none
VITE_PAYMENT_PROVIDER="razorpay"
VITE_RAZORPAY_KEY_ID=""                      # rzp_live_xxx or rzp_test_xxx
VITE_STRIPE_PUBLISHABLE_KEY=""               # pk_live_xxx (publishable only)

# --- Analytics & telemetry -----------------------------------------
VITE_GA4_MEASUREMENT_ID=""                   # G-XXXXXXX
VITE_META_PIXEL_ID=""                        # numeric pixel id
VITE_SENTRY_DSN=""                           # https://...ingest.sentry.io/...
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://app.posthog.com"

# --- Search ---------------------------------------------------------
# Provider: algolia | meilisearch | postgres
VITE_SEARCH_PROVIDER="postgres"
VITE_ALGOLIA_APP_ID=""
VITE_ALGOLIA_SEARCH_KEY=""                   # search-only key (never admin)
VITE_MEILISEARCH_HOST=""
VITE_MEILISEARCH_SEARCH_KEY=""

# --- Maps / location ------------------------------------------------
VITE_GOOGLE_MAPS_KEY=""

# --- Feature toggles (build-time) -----------------------------------
VITE_ENABLE_PWA="true"
VITE_ENABLE_LIVE_CHAT="true"
VITE_ENABLE_VOICE_SEARCH="true"
VITE_ENABLE_AB_TESTING="false"
